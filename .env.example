# Get a free key at https://the-odds-api.com (500 requests/month tier).
ODDS_API_KEY=your_key_here

# Optional: point at a different odds provider's /odds endpoint.
# ODDS_API_BASE=https://api.the-odds-api.com/v4/sports/soccer_fifa_world_cup/odds

# Credit guards on forced odds refreshes (an odds call is ~3 credits, scores ~2):
#   ODDS_MIN_REFRESH_SECONDS - ignore a forced refresh if the cache is younger
#     than this (debounce; defaults to 60s). Stops double-clicks burning credits.
#   ODDS_QUOTA_FLOOR - refuse forced odds refreshes once remaining credits hit
#     this reserve (0 = disabled). Prevents the last credits leaking into the
#     silent sample-data fallback. e.g. set 20 to hold a reserve for the final.
# Both are bypassable per request with /api/refresh?override=1.
# ODDS_MIN_REFRESH_SECONDS=60
# ODDS_QUOTA_FLOOR=0
